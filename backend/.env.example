# ── Exam time window (ISO 8601, leave blank to always allow) ──────────────────
# EXAM_START=2026-07-22T06:00:00+05:45
# EXAM_END=2026-07-22T08:00:00+05:45

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for open access (not recommended in prod)
CORS_ORIGINS=*

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Format: "<count>/<period>"  period = second | minute | hour
RATE_LIMIT=120/minute

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
# If hosted behind Nginx reverse proxy at https://fsu.pcampus.edu.np/mock-exam/api/
ROOT_PATH=/mock-exam/api

# ── Gunicorn workers (override auto-detection) ────────────────────────────────
# WORKERS=4

# ── Data files (relative to backend/ directory) ───────────────────────────────
QUESTIONS_FILE=sets_new.json
ANSWERS_FILE=answers.json
